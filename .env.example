# Public browser config for the future Supabase-backed app.
# These are safe to expose in client-side code when Row Level Security is correct.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-public-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key

# Deployment targets
APP_BASE_URL=https://play.scooppickleball.com
LOCAL_BASE_URL=http://127.0.0.1:8080

# Instagram publishing - configure these as Cloudflare secrets, not browser values.
INSTAGRAM_IG_USER_ID=your-instagram-business-user-id
INSTAGRAM_ACCESS_TOKEN=your-long-lived-instagram-access-token
INSTAGRAM_GRAPH_VERSION=v26.0

# Meta/Facebook place lookup for Instagram location tags.
# This must be a Facebook Graph API token that can call /search?type=place.
META_PLACES_ACCESS_TOKEN=your-facebook-graph-api-token-for-place-search
